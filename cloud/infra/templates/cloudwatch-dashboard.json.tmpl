{
  "start": "-PT3H",
  "periodOverride": "inherit",
  "widgets": [
    {"type": "text", "x": 0, "y": 0, "width": 24, "height": 2,
     "properties": {"markdown": "## HID kiosk cloud API (${HID_REGION}) - namespace HIDKiosk\nLatency numbers here are server-side; the 2 s SLA is measured at the kiosk (face lock -> decision). Decision/sync/alert widgets show Synthetic=false only (test/smoke traffic excluded). Sandbox region us-east-1; production ap-south-1."}},
    {"type": "metric", "x": 0, "y": 2, "width": 12, "height": 6,
     "properties": {"title": "Request latency p50 / p95 by route (ms)", "region": "${HID_REGION}", "view": "timeSeries", "stat": "p95", "period": 60,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Route,Service} MetricName=\"RequestLatencyMs\"', 'p50', 60)", "id": "p50", "label": "p50"}],
                                [{"expression": "SEARCH('{HIDKiosk,Route,Service} MetricName=\"RequestLatencyMs\"', 'p95', 60)", "id": "p95", "label": "p95"}]]}},
    {"type": "metric", "x": 12, "y": 2, "width": 12, "height": 6,
     "properties": {"title": "Rekognition match latency p50 / p95 (ms)", "region": "${HID_REGION}", "view": "timeSeries", "period": 60,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Mode,Service} MetricName=\"MatchLatencyMs\"', 'p50', 60)", "id": "m50"}],
                                [{"expression": "SEARCH('{HIDKiosk,Mode,Service} MetricName=\"MatchLatencyMs\"', 'p95', 60)", "id": "m95"}]]}},
    {"type": "metric", "x": 0, "y": 8, "width": 8, "height": 6,
     "properties": {"title": "Synced decisions by decision / mode", "region": "${HID_REGION}", "view": "timeSeries", "stacked": true, "period": 300,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Decision,Mode,Service,Synthetic} MetricName=\"Decisions\" Synthetic=\"false\"', 'Sum', 300)", "id": "d"}]]}},
    {"type": "metric", "x": 8, "y": 8, "width": 8, "height": 6,
     "properties": {"title": "Sync alerts (POST_HOC_REVOKED = ALERT_REVOKED_USER_ADMITTED)", "region": "${HID_REGION}", "view": "timeSeries", "stacked": true, "period": 300,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Alert,Service,Synthetic} MetricName=\"SyncAlerts\" Synthetic=\"false\"', 'Sum', 300)", "id": "a"}]]}},
    {"type": "metric", "x": 16, "y": 8, "width": 8, "height": 6,
     "properties": {"title": "Sync items by status (accepted / duplicate / conflict / rejected)", "region": "${HID_REGION}", "view": "timeSeries", "stacked": true, "period": 300,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Service,Status,Synthetic} MetricName=\"SyncItems\" Synthetic=\"false\"', 'Sum', 300)", "id": "s"}]]}},
    {"type": "metric", "x": 0, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Rekognition throttling (client bucket / service)", "region": "${HID_REGION}", "view": "timeSeries", "period": 60,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Service,Where} MetricName=\"RekognitionThrottled\"', 'Sum', 60)", "id": "t"}]]}},
    {"type": "metric", "x": 8, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Auth failures / 5xx by route", "region": "${HID_REGION}", "view": "timeSeries", "period": 60,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Route,Service} MetricName=\"AuthFailures\"', 'Sum', 60)", "id": "f"}],
                                [{"expression": "SEARCH('{HIDKiosk,Route,Service} MetricName=\"ServerErrors\"', 'Sum', 60)", "id": "e"}]]}},
    {"type": "metric", "x": 16, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Kiosk decision latency from synced records p50 / p95 (ms)", "region": "${HID_REGION}", "view": "timeSeries", "period": 300,
                    "metrics": [[{"expression": "SEARCH('{HIDKiosk,Mode,Service,Synthetic} MetricName=\"DecisionLatencyMs\" Synthetic=\"false\"', 'p50', 300)", "id": "k50"}],
                                [{"expression": "SEARCH('{HIDKiosk,Mode,Service,Synthetic} MetricName=\"DecisionLatencyMs\" Synthetic=\"false\"', 'p95', 300)", "id": "k95"}]]}}
  ]
}
