# Kiosk build-time settings (copy to .env.local to override). All optional.
# Edge service base URL (FastAPI on the kiosk laptop).
VITE_EDGE_URL=http://127.0.0.1:8000
# Kiosk identity sent in POST /v1/session/start (operator can override at runtime from /admin).
VITE_KIOSK_ID=KIOSK_MAIN_01
# 1 = in-browser mock edge (demo safety net). Runtime override: append ?mock=1 or ?mock=0 to the URL.
VITE_MOCK=0
