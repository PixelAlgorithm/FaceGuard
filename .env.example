# Copy to .env and fill in. Never commit .env. Names match docs/API.md + docs/SURPRISE_CHALLENGES.md.
# The edge, the eval tools and a laptop-hosted cloud all read this one project .env: keep it chmod 600, owned by
# the OS user that runs the edge (GET /v1/health reports `env_file_permissive` otherwise; docs/ARCHITECTURE.md §2.1).
AWS_REGION=us-east-1          # Workshop Studio sandbox: us-east-1 only (production: ap-south-1)
AWS_PROFILE=hid-sandbox
REKOGNITION_COLLECTION_ID=hid-kiosk-users
DDB_TABLE_USERS=hid_users
DDB_TABLE_DECISIONS=hid_decisions
S3_AUDIT_BUCKET=hid-kiosk-audit-<suffix>
KMS_KEY_ID=
SES_SENDER=you@example.com
CLOUD_API_URL=                 # empty = no cloud configured -> edge runs OFFLINE rules; must be https:// unless the host is loopback or DEMO_MODE=1, else the edge does not start (edge/config.py validate_cloud_url)
CLOUD_API_KEY=                 # shared X-Api-Key: the edge sends it, the cloud requires it at startup (cloud/tools/ensure_env.py generates it)
KIOSK_ID=KIOSK_MAIN_01         # must exist in config/schedule.example.json kiosks{}
KIOSK_HMAC_KEY=                # this kiosk's HMAC key (request signing + sync item HMAC); the cloud must hold the same value in KIOSK_KEYS_JSON[KIOSK_ID] (or use it as the shared key with ALLOW_SHARED_KIOSK_KEY=1)
# Edge service
EDGE_PORT=8000
EDGE_DATA_KEY=                 # Fernet key (templates + offline decision log; the staff store and audit-chain keys are HKDF-derived from it): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SCHEDULE_BUNDLE_HMAC_KEY=      # HMAC-SHA256 key for schedule bundle signatures, same value on edge and cloud; the cloud refuses to start without it (hackathon; Ed25519 in production)
SCHEDULE_BUNDLE_KEY_ID=        # bundle signature key_id the edge accepts and the cloud stamps (empty = demo-k1)
CARD_ID_PEPPER=                # HMAC-SHA256 pepper for simulated HID card IDs
ADMIN_TOKEN=                   # LEGACY ONLY: the old shared X-Admin-Token the edge accepts when AUTH_LEGACY_ADMIN_TOKEN=1 (required then). Also the cloud's legacy token when CLOUD_ADMIN_TOKEN is empty, and the eval tools' token with FG_ALLOW_LEGACY_ADMIN_TOKEN=1. Never sent edge -> cloud
FORCE_OFFLINE=false            # demo switch for SC2: forced OFFLINE with no auto-revert (POST /v1/admin/mode reverts after max_minutes)
EDGE_LAN_PORT=8001             # LAN listener serving ONLY /v1/depth/* for the DepthProbe iPhone app
DEPTH_DEVICE_TOKEN=            # X-Depth-Token required on /v1/depth/*: python -c "import secrets;print(secrets.token_urlsafe(24))"
DEMO_MODE=0                    # 1 = enables POST /v1/admin/clock, /v1/admin/random-challenge (else 403 NOT_DEMO_MODE), the kiosk switch, /docs and a plain-http CLOUD_API_URL; reported as degraded `demo_mode`
EDGE_CORS_ORIGINS=             # comma list of exact kiosk origins (scheme://host[:port], no path, no wildcard; else the edge does not start); empty = http://localhost:5173,http://127.0.0.1:5173; also the foreign-Origin 403 allow-list
EDGE_EXTRA_ALLOWED_HOSTS=      # comma list of extra exact Host names the main API answers (no wildcard; default only 127.0.0.1, localhost, [::1])
# Edge staff authentication (docs/API.md §0.1; read by the edge and `python -m edge.auth`). Defaults in brackets,
# allowed range in braces; empty = default. An out-of-range or non-integer value stops the edge at startup.
AUTH_LEGACY_ADMIN_TOKEN=       # [0] 1 = the edge also accepts the deprecated X-Admin-Token (= ADMIN_TOKEN, required) as legacy:admin_token (all edge perms except staff:manage, codes:rotate_any); audited, health degraded `legacy_admin_token`. Use 0/1 only. A cloud reading this same .env ALSO turns on its legacy X-Admin-Token (role admin, secret CLOUD_ADMIN_TOKEN else ADMIN_TOKEN)
AUTH_SESSION_IDLE_MIN=         # staff session idle timeout, minutes [30] {1..1440, and <= AUTH_SESSION_MAX_HOURS x 60}; only non-GET requests / X-FG-Activity: 1 / POST /v1/auth/activity refresh it
AUTH_SESSION_MAX_HOURS=        # absolute staff session lifetime, hours [12] {1..72}
AUTH_MAX_SESSIONS_PER_USER=    # concurrent sessions per staff account, oldest evicted [5] {1..50}
AUTH_LOCKOUT_THRESHOLD=        # failed sign-ins per username before the progressive delay starts [5] {1..100}
AUTH_LOCKOUT_MIN=              # cap of the per-username progressive delay, minutes [15] {1..1440}
AUTH_LOGIN_GLOBAL_MAX=         # all sign-in attempts per window, all usernames, before 429 RATE_LIMITED [60] {1..100000}
AUTH_LOGIN_GLOBAL_WINDOW_MIN=  # window of AUTH_LOGIN_GLOBAL_MAX, minutes [5] {1..1440}
# Roles that must enrol TOTP before anything else [admin,security_officer]; comma list of edge roles (an unknown role
# stops the edge). Keep this line commented for the default. Unset or empty = the default; only "none" means NO role needs MFA.
#AUTH_MFA_REQUIRED_ROLES=admin,security_officer
AUTH_AUDIT_MAX_BYTES=          # rotate <EDGE_DATA_DIR>/audit.jsonl at this size, bytes [5242880] {65536..1073741824}
AUTH_AUDIT_KEEP=               # rotated audit files kept (audit.jsonl.1..N) [5] {1..100}
STAFF_STORE_KEY=               # optional Fernet key for staff.fernet, read by the edge and `python -m edge.auth` (overrides the HKDF key derived from EDGE_DATA_KEY; move with `python -m edge.auth rekey`)
# Edge -> cloud admin credential (outbound; never falls back to ADMIN_TOKEN)
CLOUD_EDGE_PROXY_KEY=          # cloud API key with role edge_proxy bound to KIOSK_ID (cloud/tools/apikey.py), sent as Authorization: Bearer
CLOUD_ADMIN_TOKEN=             # LEGACY X-Admin-Token: the edge sends it only when CLOUD_EDGE_PROXY_KEY is empty; the cloud accepts it (before ADMIN_TOKEN) only with AUTH_LEGACY_ADMIN_TOKEN=1; cloud/tools send it only with FG_ALLOW_LEGACY_ADMIN_TOKEN=1
CLOUD_TLS_CA_FILE=             # optional PEM the cloud certificate must chain to (only that CA is trusted); empty = system trust store; a missing / unreadable file stops the edge
# Eval / bench / ops tooling (edge API keys from `python -m edge.auth create-api-key`)
FG_EVAL_API_KEY=               # edge API key (fgk_...), role evaluator: eval/capture.py, eval/snapshot_metrics.py (process env first, then this .env)
FG_OPS_API_KEY=                # edge API key (fgk_...), roles security_officer + evaluator: eval/scenarios/run_scenarios.py (without it D01/D02 are NOT_RUN)
FG_ALLOW_LEGACY_ADMIN_TOKEN=   # exactly 1 = when no key is set, eval tools send ADMIN_TOKEN and cloud/tools send CLOUD_ADMIN_TOKEN else ADMIN_TOKEN (X-Admin-Token). Read from the process env first, then this .env (eval/evallib/auth.py, cloud/tools/cloudclient.py)
FG_CLOUD_ADMIN_KEY=            # cloud API key (fgk_...) for cloud/tools admin calls (cloudclient: cloudcurl --admin, smoke, smoke_noface, smoke_upload), sent as Authorization: Bearer
# Cloud service only (cloud/app/config.py)
CLOUD_API_KEYS_JSON=           # JSON list [{key_id, sha256, roles, name, kiosk_ids?, expires_at?}] from cloud/tools/apikey.py output; roles admin|edge_proxy|auditor, edge_proxy needs exactly one kiosk_id, expires_at ISO-8601 with timezone; malformed = cloud does not start; empty = no key-based admin
KIOSK_KEYS_JSON=               # JSON {kiosk_id: hmac_key}: per-kiosk HMAC keys (required unless ALLOW_SHARED_KIOSK_KEY=1; cloud/app and the cloud/infra deploy tooling both refuse to start / deploy without one of them)
ALLOW_SHARED_KIOSK_KEY=        # [0] 1 = kiosks known to the schedule but absent from KIOSK_KEYS_JSON may sign with the shared KIOSK_HMAC_KEY (required then; demo only). The deploy tooling refuses a .env with neither KIOSK_KEYS_JSON nor this + KIOSK_HMAC_KEY (cloud/SANDBOX.md §14)
OTP_PEPPER=                    # pepper for stored e-mail OTP hashes (required unless STORE_BACKEND=memory, the cloud default)
CLOUD_ACCEPT_BARE_PATH_SIG=    # [0] 1 = transition only: also accept request signatures over the path without ?query
CLOUD_DATA_KEY=                # Fernet key for cloud TOTP seeds when KMS_KEY_ID is empty (SECRETBOX=auto; with neither, seeds are NOT encrypted); ensure_env generates it
AUTH_SKEW_S=                   # cloud only: allowed |now - X-Timestamp| for kiosk-signed requests, seconds [60] (no range check)
